{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Route plan (route-strategist)",
  "type": "object",
  "definitions": {
    "ref": {
      "type": "object",
      "required": [
        "value",
        "fact"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "fact": {
          "type": "string",
          "pattern": "^F-\\d{4}$"
        }
      }
    },
    "req": {
      "type": "object",
      "required": [
        "type",
        "fact"
      ],
      "properties": {
        "type": {
          "enum": [
            "skill",
            "quest",
            "item",
            "unlock",
            "diary",
            "other"
          ]
        },
        "skill": {
          "type": "string"
        },
        "level": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "boostable": {
          "type": "boolean"
        },
        "fact": {
          "type": "string",
          "pattern": "^F-\\d{4}$"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "step_id",
        "kind",
        "title",
        "facts",
        "rationale"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^S\\d{2,3}[a-z]?$"
        },
        "kind": {
          "enum": [
            "train",
            "quest",
            "unlock",
            "reward",
            "prep",
            "travel",
            "milestone"
          ]
        },
        "title": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "until_level": {
          "type": "integer",
          "minimum": 2,
          "maximum": 99
        },
        "min_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "xp_per_action": {
          "$ref": "#/definitions/ref"
        },
        "xp_per_hour": {
          "$ref": "#/definitions/ref"
        },
        "est_hours": {
          "$ref": "#/definitions/ref"
        },
        "supplies_per_action": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "qty"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "qty": {
                "$ref": "#/definitions/ref"
              }
            }
          }
        },
        "secondary_xp_per_action": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "skill",
              "xp"
            ],
            "properties": {
              "skill": {
                "type": "string"
              },
              "xp": {
                "$ref": "#/definitions/ref"
              }
            }
          }
        },
        "xp_rewards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "skill",
              "xp"
            ],
            "properties": {
              "skill": {
                "type": "string"
              },
              "xp": {
                "$ref": "#/definitions/ref"
              }
            }
          }
        },
        "lamp_rewards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer"
              },
              "xp": {
                "$ref": "#/definitions/ref"
              },
              "xp_per_level": {
                "$ref": "#/definitions/ref"
              },
              "skill_choices": {
                "type": "array"
              },
              "chosen_skill": {
                "type": "string"
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/req"
          }
        },
        "gear": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inventory": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^F-\\d{4}$"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        },
        "why_not_faster": {
          "type": "string"
        },
        "update_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "income_per_hour": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "qty"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "qty": {
                "$ref": "#/definitions/ref"
              },
              "note": {
                "type": "string"
              },
              "convert": {
                "type": "object",
                "required": [
                  "to_item",
                  "per_unit"
                ],
                "properties": {
                  "to_item": {
                    "type": "string"
                  },
                  "per_unit": {
                    "$ref": "#/definitions/ref"
                  },
                  "divide_by": {
                    "$ref": "#/definitions/ref"
                  }
                }
              }
            }
          }
        },
        "income_per_action": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "qty"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "qty": {
                "$ref": "#/definitions/ref"
              },
              "gp_each": {
                "$ref": "#/definitions/ref"
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "agent",
        "started_at",
        "finished_at",
        "inputs",
        "actions",
        "decisions",
        "limitations"
      ],
      "properties": {
        "agent": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        },
        "dispatch_ref": {
          "type": "string",
          "description": "dispatch/NNN-<agent>.md file this work answers"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "search",
                  "fetch",
                  "read",
                  "compute",
                  "write",
                  "verify",
                  "decide",
                  "request"
                ]
              },
              "detail": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "decision",
              "reason"
            ],
            "properties": {
              "decision": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "alternatives_considered": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refs": {
                "type": "array"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "option_id",
        "title",
        "step_ids",
        "justification",
        "pros",
        "cons"
      ],
      "properties": {
        "option_id": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "title": {
          "type": "string"
        },
        "step_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "justification": {
          "type": "string",
          "minLength": 20
        },
        "pros": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "best_for": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F-\\d{4}$"
          }
        },
        "profit_note": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "target",
    "start_xp",
    "routes",
    "steps",
    "assumptions",
    "provenance",
    "decision_points"
  ],
  "properties": {
    "target": {
      "type": "object",
      "required": [
        "skill",
        "from_level",
        "to_level"
      ]
    },
    "start_xp": {
      "type": "integer",
      "minimum": 0
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "label",
          "intent",
          "step_ids"
        ],
        "properties": {
          "route_id": {
            "enum": [
              "safest",
              "balanced",
              "fastest",
              "afk",
              "custom"
            ]
          },
          "label": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "step_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisite_checklist": {
      "type": "array"
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    },
    "decision_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dp_id",
          "at_level",
          "question",
          "options",
          "recommended"
        ],
        "properties": {
          "dp_id": {
            "type": "string",
            "pattern": "^DP\\d{2}$"
          },
          "at_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "until_level": {
            "type": "integer"
          },
          "question": {
            "type": "string"
          },
          "conditions": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/definitions/option"
            }
          },
          "recommended": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "recommendation_reason": {
            "type": "string"
          }
        }
      }
    }
  }
}