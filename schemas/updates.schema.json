{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Update sweep (patch-sentinel)",
  "type": "object",
  "definitions": {
    "source": {
      "type": "object",
      "required": [
        "tier",
        "title",
        "url",
        "retrieved"
      ],
      "properties": {
        "tier": {
          "enum": [
            "T1",
            "T2",
            "T3",
            "T4"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "revid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "published": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "type": "string",
          "maxLength": 600
        },
        "fetched_by": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "subject",
        "attribute",
        "value",
        "statement",
        "sources",
        "confidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^C-[A-Z]{3,5}-\\d{3,4}$"
        },
        "subject": {
          "type": "string",
          "minLength": 2
        },
        "attribute": {
          "type": "string",
          "minLength": 2
        },
        "value": {},
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 5
        },
        "scope": {
          "type": "object"
        },
        "released": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source"
          }
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "agent",
        "started_at",
        "finished_at",
        "inputs",
        "actions",
        "decisions",
        "limitations"
      ],
      "properties": {
        "agent": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        },
        "dispatch_ref": {
          "type": "string",
          "description": "dispatch/NNN-<agent>.md file this work answers"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "search",
                  "fetch",
                  "read",
                  "compute",
                  "write",
                  "verify",
                  "decide",
                  "request"
                ]
              },
              "detail": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "decision",
              "reason"
            ],
            "properties": {
              "decision": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "alternatives_considered": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refs": {
                "type": "array"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "desk",
    "as_of",
    "window",
    "sources_swept",
    "items",
    "claims",
    "gaps",
    "provenance"
  ],
  "properties": {
    "desk": {
      "const": "updates"
    },
    "as_of": {
      "type": "string"
    },
    "window": {
      "type": "object",
      "required": [
        "from",
        "to"
      ]
    },
    "sources_swept": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "retrieved"
        ]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "update_id",
          "date",
          "title",
          "kinds",
          "relevance",
          "summary",
          "claim_ids"
        ],
        "properties": {
          "update_id": {
            "type": "string",
            "pattern": "^U-\\d{3}$"
          },
          "date": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kinds": {
            "type": "array",
            "items": {
              "enum": [
                "new_quest",
                "new_skill",
                "new_area",
                "new_boss",
                "new_activity",
                "rate_change",
                "mechanic_change",
                "game_mode",
                "death_rules",
                "qol",
                "hotfix",
                "upcoming",
                "economy"
              ]
            }
          },
          "relevance": {
            "enum": [
              "high",
              "medium",
              "low",
              "none"
            ]
          },
          "summary": {
            "type": "string"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "invalidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/claim"
      }
    },
    "upcoming_30d": {
      "type": "array"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    }
  }
}