{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Risk register (risk-officer)",
  "type": "object",
  "definitions": {
    "factor": {
      "type": "object",
      "required": [
        "score",
        "rationale"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "rationale": {
          "type": "string",
          "minLength": 3
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "step_id",
        "factors",
        "flags",
        "hw_death_classification",
        "mitigations",
        "preconditions",
        "bailout",
        "verdict"
      ],
      "properties": {
        "step_id": {
          "type": "string"
        },
        "hazards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "description"
            ],
            "properties": {
              "facts": {
                "type": "array"
              }
            }
          }
        },
        "factors": {
          "type": "object",
          "required": [
            "lethality",
            "pvp",
            "escape",
            "attention",
            "disconnect",
            "unpredictability",
            "exposure",
            "knowledge"
          ],
          "additionalProperties": false,
          "properties": {
            "lethality": {
              "$ref": "#/definitions/factor"
            },
            "pvp": {
              "$ref": "#/definitions/factor"
            },
            "escape": {
              "$ref": "#/definitions/factor"
            },
            "attention": {
              "$ref": "#/definitions/factor"
            },
            "disconnect": {
              "$ref": "#/definitions/factor"
            },
            "unpredictability": {
              "$ref": "#/definitions/factor"
            },
            "exposure": {
              "$ref": "#/definitions/factor"
            },
            "knowledge": {
              "$ref": "#/definitions/factor"
            }
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "WILDERNESS",
              "DEEP_WILDERNESS",
              "PVP_HOTSPOT",
              "ONE_SHOT_POSSIBLE",
              "LOCKED_INSTANCE_LETHAL",
              "DISCONNECT_FATAL",
              "UNVERIFIED_MECHANIC",
              "NEW_CONTENT",
              "HW_UNSAFE_ACTIVITY",
              "POISON_OR_VENOM",
              "AGGRESSIVE_NPCS_ON_ROUTE",
              "LOW_HP_SKILLING_DAMAGE",
              "TELEPORT_RESTRICTED",
              "QUEST_BOSS"
            ]
          }
        },
        "hw_death_classification": {
          "type": "object",
          "required": [
            "status",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "UNSAFE_DEATH",
                "SAFE_DEATH",
                "NO_DEATH_POSSIBLE"
              ]
            },
            "facts": {
              "type": "array"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "mitigations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "action",
              "reduces",
              "mandatory"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "reduces": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              },
              "removes_flags": {
                "type": "array"
              },
              "mandatory": {
                "type": "boolean"
              },
              "facts": {
                "type": "array"
              }
            }
          }
        },
        "preconditions": {
          "type": "object",
          "properties": {
            "min_hitpoints": {
              "type": [
                "integer",
                "null"
              ]
            },
            "min_combat": {
              "type": [
                "integer",
                "null"
              ]
            },
            "food": {
              "type": "string"
            },
            "required_items": {
              "type": "array"
            },
            "stop_conditions": {
              "type": "array"
            }
          }
        },
        "bailout": {
          "type": "string",
          "minLength": 5
        },
        "verdict": {
          "enum": [
            "approve",
            "approve_with_conditions",
            "veto"
          ]
        },
        "verdict_reason": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "agent",
        "started_at",
        "finished_at",
        "inputs",
        "actions",
        "decisions",
        "limitations"
      ],
      "properties": {
        "agent": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        },
        "dispatch_ref": {
          "type": "string",
          "description": "dispatch/NNN-<agent>.md file this work answers"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "search",
                  "fetch",
                  "read",
                  "compute",
                  "write",
                  "verify",
                  "decide",
                  "request"
                ]
              },
              "detail": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "decision",
              "reason"
            ],
            "properties": {
              "decision": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "alternatives_considered": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refs": {
                "type": "array"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "profile_basis",
    "risk_appetite",
    "entries",
    "route_verdicts",
    "provenance"
  ],
  "properties": {
    "profile_basis": {
      "type": "object"
    },
    "risk_appetite": {
      "enum": [
        "cautious",
        "standard",
        "bold"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/entry"
      }
    },
    "route_verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "verdict"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "approve",
              "approve_with_conditions",
              "veto"
            ]
          }
        }
      }
    },
    "general_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    }
  }
}