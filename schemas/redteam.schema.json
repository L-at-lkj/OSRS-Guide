{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Red-team findings (red-team)",
  "type": "object",
  "required": [
    "attack_surface",
    "findings",
    "provenance"
  ],
  "properties": {
    "attack_surface": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "severity",
          "scenario",
          "recommendation",
          "status"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^RT-\\d{2,3}$"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "step_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "scenario": {
            "type": "string",
            "minLength": 10
          },
          "evidence": {
            "type": "array"
          },
          "recommendation": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "fixed",
              "accepted_by_user",
              "rejected"
            ]
          },
          "resolution": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    }
  },
  "definitions": {
    "provenance": {
      "type": "object",
      "required": [
        "agent",
        "started_at",
        "finished_at",
        "inputs",
        "actions",
        "decisions",
        "limitations"
      ],
      "properties": {
        "agent": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        },
        "dispatch_ref": {
          "type": "string",
          "description": "dispatch/NNN-<agent>.md file this work answers"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "search",
                  "fetch",
                  "read",
                  "compute",
                  "write",
                  "verify",
                  "decide",
                  "request"
                ]
              },
              "detail": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "decision",
              "reason"
            ],
            "properties": {
              "decision": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "alternatives_considered": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refs": {
                "type": "array"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}