{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Requirements brief (intake-officer)",
  "type": "object",
  "required": [
    "job_id",
    "request",
    "guide_type",
    "scope",
    "game_mode",
    "profile",
    "preferences",
    "acceptance_criteria",
    "recency_window",
    "provenance"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "request": {
      "type": "string",
      "minLength": 3
    },
    "guide_type": {
      "enum": [
        "skill_training",
        "quest_route",
        "account_progression",
        "boss_or_activity",
        "money_making",
        "diary",
        "other"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "string"
        },
        "from_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "to_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "items": {
          "type": "array"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "game_mode": {
      "type": "object",
      "required": [
        "world_type",
        "account_type",
        "membership",
        "death_ruleset"
      ],
      "properties": {
        "world_type": {
          "enum": [
            "hardcore_worlds",
            "main",
            "other"
          ]
        },
        "account_type": {
          "enum": [
            "standard",
            "ironman",
            "hardcore_ironman",
            "ultimate_ironman",
            "group_ironman",
            "hardcore_group_ironman",
            "unknown"
          ]
        },
        "membership": {
          "enum": [
            "member",
            "f2p"
          ]
        },
        "death_ruleset": {
          "enum": [
            "hardcore_worlds",
            "hcim",
            "hcgim",
            "standard"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "stats",
        "stats_source"
      ],
      "properties": {
        "stats": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "stats_source": {
          "enum": [
            "user_stated",
            "hiscores",
            "wikisync",
            "assumed_minimum"
          ]
        },
        "stats_verified_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "quests_completed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diaries": {
          "type": "array"
        },
        "unlocks": {
          "type": "array"
        },
        "bank_notes": {
          "type": "string"
        },
        "gp_budget": {
          "type": [
            "integer",
            "null"
          ]
        },
        "build": {
          "type": "object",
          "required": [
            "archetype",
            "skill_caps",
            "xp_rules",
            "lamp_policy"
          ],
          "properties": {
            "archetype": {
              "type": "string"
            },
            "skill_caps": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              }
            },
            "xp_rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lamp_policy": {
              "type": "string"
            },
            "confirmed": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "preferences": {
      "type": "object",
      "required": [
        "risk_appetite",
        "optimise_for"
      ],
      "properties": {
        "risk_appetite": {
          "enum": [
            "cautious",
            "standard",
            "bold",
            "informed"
          ]
        },
        "optimise_for": {
          "enum": [
            "safety",
            "balanced",
            "speed",
            "afk",
            "profit",
            "low_cost"
          ]
        },
        "attention": {
          "enum": [
            "afk",
            "semi",
            "active"
          ]
        },
        "session_minutes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "confirmed"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "recency_window": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    }
  },
  "definitions": {
    "provenance": {
      "type": "object",
      "required": [
        "agent",
        "started_at",
        "finished_at",
        "inputs",
        "actions",
        "decisions",
        "limitations"
      ],
      "properties": {
        "agent": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        },
        "dispatch_ref": {
          "type": "string",
          "description": "dispatch/NNN-<agent>.md file this work answers"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "search",
                  "fetch",
                  "read",
                  "compute",
                  "write",
                  "verify",
                  "decide",
                  "request"
                ]
              },
              "detail": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "decision",
              "reason"
            ],
            "properties": {
              "decision": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "alternatives_considered": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refs": {
                "type": "array"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}