{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Release audit (qa-auditor)",
  "type": "object",
  "required": [
    "content_sha256",
    "checks",
    "spot_checks",
    "decision",
    "reasons",
    "provenance"
  ],
  "properties": {
    "content_sha256": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "check",
          "result"
        ],
        "properties": {
          "result": {
            "enum": [
              "pass",
              "fail",
              "warn"
            ]
          }
        }
      }
    },
    "spot_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "result"
        ],
        "properties": {
          "result": {
            "enum": [
              "match",
              "mismatch",
              "unreachable"
            ]
          }
        }
      }
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    }
  },
  "definitions": {
    "provenance": {
      "type": "object",
      "required": [
        "agent",
        "started_at",
        "finished_at",
        "inputs",
        "actions",
        "decisions",
        "limitations"
      ],
      "properties": {
        "agent": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        },
        "dispatch_ref": {
          "type": "string",
          "description": "dispatch/NNN-<agent>.md file this work answers"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "search",
                  "fetch",
                  "read",
                  "compute",
                  "write",
                  "verify",
                  "decide",
                  "request"
                ]
              },
              "detail": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "decision",
              "reason"
            ],
            "properties": {
              "decision": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "alternatives_considered": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refs": {
                "type": "array"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}